# Line endings: text files are stored LF in the repository and checked out CRLF on every
# machine, whatever core.autocrlf says, so a clone never prints "LF will be replaced by CRLF"
# and two machines never disagree about a file's line endings.
* text=auto eol=crlf

# Binary files are left alone.
*.onnx binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.zip binary
*.gguf binary
*.bin binary
*.pdf binary
